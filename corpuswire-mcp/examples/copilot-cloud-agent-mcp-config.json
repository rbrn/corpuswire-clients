{
  "mcpServers": {
    "corpuswire": {
      "type": "stdio",
      "command": "node",
      "args": [
        "./clients/corpuswire-mcp/bin/corpuswire-mcp.js"
      ],
      "env": {
        "CORPUSWIRE_BASE_URL": "http://127.0.0.1:8000",
        "CORPUSWIRE_REPO_PATH": "/workspace",
        "CORPUSWIRE_OUTPUT_MODE": "copilot",
        "CORPUSWIRE_LOCAL_ONLY": "true",
        "CORPUSWIRE_TOP_K": "5",
        "CORPUSWIRE_SYNC_ENABLED": "false",
        "CORPUSWIRE_BASIC_AUTH": "$COPILOT_MCP_CORPUSWIRE_BASIC_AUTH"
      },
      "tools": [
        "corpuswire_search",
        "corpuswire_enhance_prompt",
        "corpuswire_rate_result",
        "corpuswire_quality_review",
        "corpuswire_health",
        "corpuswire_diagnose_workspace",
        "corpuswire_doctor"
      ]
    }
  }
}
